rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil : pseudo (20 caractères max), année et avatar, rien d'autre.
    function profilValide(p) {
      return p is map
        && p.keys().hasOnly(["pseudo", "annee", "avatar"])
        && p.get("pseudo", "") is string && p.get("pseudo", "").size() <= 20
        && p.get("annee", "") is string && p.get("annee", "").size() <= 40
        && p.get("avatar", "") is string && p.get("avatar", "").size() <= 20;
    }

    // Chaque élève ne peut lire et écrire que son propre document.
    match /eleves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["progression", "records", "revisions", "profil", "maj"])
        && request.resource.data.progression is string && request.resource.data.progression.size() < 200000
        && request.resource.data.records is string && request.resource.data.records.size() < 50000
        && request.resource.data.get("revisions", "") is string && request.resource.data.get("revisions", "").size() < 200000
        && profilValide(request.resource.data.get("profil", {}));
    }

    // Signalements d'erreur : n'importe qui peut en ENVOYER un (sans compte),
    // personne ne peut les lire ni les modifier depuis le site (lecture dans la console Firebase).
    match /signalements/{id} {
      allow create: if request.resource.data.keys().hasOnly(["epreuve", "theme", "question", "type", "message", "date"])
        && request.resource.data.epreuve is string && request.resource.data.epreuve.size() <= 5
        && request.resource.data.theme is string && request.resource.data.theme.size() <= 80
        && request.resource.data.question is string && request.resource.data.question.size() <= 600
        && request.resource.data.type in ["Réponse fausse", "Explication pas claire", "Schéma faux", "Faute ou coquille", "Autre"]
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.date == request.time;
      allow read, update, delete: if false;
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
